# =====================================================================
# Coeso Offers Board — environment
# Copy to `.env` (dev) or set in your host's secret manager.
# =====================================================================

# --- App ---------------------------------------------------------------
# Public origin of the app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-48-bytes-of-random-hex

# --- Database ----------------------------------------------------------
# Provided automatically by the hosting platform (a D1 binding named `DB`).
# `npm run dev` reads the same binding from the generated Wrangler config,
# so nothing needs to be set here locally.

# --- Optional ----------------------------------------------------------
# Fallback Discord channel webhook that announces newly published offers.
# Prefer /admin/settings: its stored URL wins over this value, and both only
# post while the board is on the paid plan. Sign-in is email + password.
DISCORD_WEBHOOK_URL=

# Set to "false" to deploy an empty board instead of the sample offers that
# are written once into an empty database.
SEED_DEMO_DATA=true

# --- Billing (Whop) -----------------------------------------------------
# All money is collected by Whop; this app only creates hosted checkouts and
# verifies webhooks. See README.md → "Whop setup" for the full walkthrough.
#
# Server-side API key from the Whop dashboard (Business settings → API keys).
# Never expose this to the browser.
WHOP_API_KEY=

# Signing secret of the /api/webhooks/whop endpoint (`ws_…`).
WHOP_WEBHOOK_SECRET=

# Optional `biz_…` account id sent with checkout creation.
WHOP_ACCOUNT_ID=

# REST base. Leave unset in production; for development use the sandbox:
#   https://sandbox-api.whop.com/api/v1
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1

# Where "Manage or cancel on Whop" points (Whop's member hub).
WHOP_MANAGE_URL=https://whop.com/hub

# One Whop plan id per price in src/lib/pricing.ts. Standard and founding
# plans are separate Whop plans on purpose: changing a standard price must not
# touch existing founding subscribers.
WHOP_PLAN_ID_PRO_MONTHLY=
WHOP_PLAN_ID_PRO_ANNUAL=
WHOP_PLAN_ID_ELITE_MONTHLY=
WHOP_PLAN_ID_ELITE_ANNUAL=
WHOP_PLAN_ID_PRO_FOUNDING=
WHOP_PLAN_ID_ELITE_FOUNDING=
