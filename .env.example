[TEMPLATE]
# Copy to .env and adjust. docker-compose reads DB_* for the MySQL container;
# the backend reads them for the datasource and JWT.

# --- Database (docker-compose defaults shown) ---
DB_URL=jdbc:mysql://localhost:3306/roster?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USER=roster
DB_PASSWORD=roster
MYSQL_ROOT_PASSWORD=root

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-generate-a-real-one-32b
# Access token lifetime (minutes). Default 12 hours.
JWT_TTL_MINUTES=720

# --- CORS (comma separated origins for the Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Server ---
SERVER_PORT=8080

# --- Billing (Phase 4) ---
# Which payment provider to use: stripe or razorpay.
# Both verify webhook signatures before parsing the raw body; Razorpay also
# powers paid office-hour bookings (POST /api/payments/webhooks/razorpay).
BILLING_PROVIDER=stripe

# Stripe (https://dashboard.stripe.com/apikeys). Leave empty in local dev:
# checkout then answers 503 and webhooks are rejected (no secret to verify).
STRIPE_SECRET_KEY=
# From the webhook endpoint config (https://dashboard.stripe.com/webhooks):
# this is what verifies Stripe-Signature over the raw body.
STRIPE_WEBHOOK_SECRET=
# Override only for tests / Stripe mocks.
# STRIPE_API_BASE=https://api.stripe.com

# Razorpay - implemented: HMAC verified before parse, idempotent.
# Empty keys make office-hour checkout answer 503 (like Stripe).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend: where Stripe sends the user after checkout.
APP_BASE_URL=http://localhost:5173

# --- Discord (Phase 5) ---
# "Login with Discord" OAuth application (https://discord.com/developers/applications).
# Both must be set for the login flow to work; otherwise the endpoints answer 503
# with code DISCORD_NOT_CONFIGURED.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match an OAuth2 redirect configured on the Discord application.
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord
# Bot token of the notification / role-sync bot (invite it to the guild with the
# Guild Members scope). Leave empty: notifications are dropped and role sync
# makes no changes.
DISCORD_BOT_TOKEN=
# Override only for tests / Discord mocks.
# DISCORD_API_BASE=https://discord.com/api

# --- Tests ---
# Only used when Docker is unavailable (Testcontainers is the default).
# Tests create and wipe the schema in this database.
ROSTER_TEST_DB_URL=jdbc:mysql://localhost:3306/roster_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
ROSTER_TEST_DB_USER=roster
ROSTER_TEST_DB_PASSWORD=roster
