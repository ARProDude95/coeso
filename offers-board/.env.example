# --- Admin access (required for /offers/admin) -------------------------
# Password for the admin control room.
ADMIN_PASSWORD=
# Long random string used to sign the admin cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- Production database (Turso) ---------------------------------------
# Leave both empty locally: the app then uses a SQLite file in ./.data
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional -----------------------------------------------------------
# SEED_DEMO_DATA=false     # start with an empty board instead of demo offers
# LOCAL_DB_PATH=./.data/offers.db
