# --- Owner admin account (required) ------------------------------------
# The first admin account is created from these on the first request, then
# lives (hashed) in the database. Changing them later does NOT reset the live
# password - rotate it from the dashboard ("Reset password").
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Long random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- Storage -----------------------------------------------------------
# The database is the platform-provided D1 binding named DB. Provision it for
# each site environment (Freebuff Sites -> Storage) and deploy; there is no
# connection string. Local `next dev` uses the binding from
# freebuff.wrangler.jsonc and stores state under .wrangler/.

# --- Optional -----------------------------------------------------------
# SEED_DEMO_DATA=false     # start with an empty board instead of demo offers

# Discord webhook pinged whenever a member applies to an offer.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Optional mention prepended to the notification, e.g. <@&123456789012345678>
# for a role ping. Leave empty to avoid pinging anyone.
DISCORD_MENTION=

# --- Owner lockout recovery (leave unset unless you are locked out) ------
# One-time token that lets the owner reset the admin password without a
# session. While this is unset, POST /api/auth/reset-admin answers 404 and the
# board has no reset surface at all - keep it that way day to day.
#
# To use it:
#   1. Generate a token (32+ chars):
#        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   2. Set it as ADMIN_RESET_TOKEN in the deployment secrets, then deploy.
#   3. POST {"token":"<token>","password":"<new admin password>"} to
#      /api/auth/reset-admin. Expect 200 {"ok":true,"username":"..."}.
#   4. Sign in with the new password, then delete this variable again.
#
# A token is single-use: once it has reset the password its hash is stored in
# the database and the same token is refused (409) from then on. A new token
# value is needed for any later reset.
ADMIN_RESET_TOKEN=
