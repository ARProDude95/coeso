{
  "name": "coeso-offers-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions react-server --import tsx --test tests/*.test.ts",
    "smoke:whop": "tsx scripts/whop-smoke.ts",
    "preview": "npx opennextjs-cloudflare build --openNextConfigPath freebuff.open-next.config.ts --config freebuff.wrangler.jsonc && npx opennextjs-cloudflare preview --config freebuff.wrangler.jsonc"
  },
  "dependencies": {
    "@whop/sdk": "^2.6.0",
    "jose": "^6.2.13",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
